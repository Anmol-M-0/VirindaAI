# Optional. The default runtime is offline.
MARINA_DATA_DIR=.local/marina
MARINA_PROVIDER=echo
MARINA_MODEL=offline-demo
MARINA_LOG_LEVEL=INFO

# Voice interaction
MARINA_AUDIO_MODE=wake_word
MARINA_WAKE_WORD=hey marina
MARINA_WAKE_THRESHOLD=0.5
MARINA_END_SILENCE_MS=750
MARINA_FOLLOW_UP_WINDOW_MS=8000

# Background job backbone
MARINA_JOB_BROKER=inprocess
# Required when MARINA_JOB_BROKER=nats
# MARINA_NATS_URL=nats://127.0.0.1:4222
# MARINA_NATS_CREDS=
MARINA_NATS_STREAM=marina_jobs
MARINA_NATS_SUBJECT_PREFIX=marina.jobs
MARINA_NATS_DURABLE=marina-workers
