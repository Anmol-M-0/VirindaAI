# Optional. The default runtime is offline.
VIRINDA_DATA_DIR=.local/virinda
VIRINDA_PROVIDER=echo
VIRINDA_MODEL=offline-demo
VIRINDA_LOG_LEVEL=INFO

# Voice interaction
VIRINDA_AUDIO_MODE=wake_word
VIRINDA_WAKE_WORD=hey virinda
VIRINDA_WAKE_THRESHOLD=0.5
VIRINDA_END_SILENCE_MS=750
VIRINDA_FOLLOW_UP_WINDOW_MS=8000

# Background job backbone
VIRINDA_JOB_BROKER=inprocess
# Required when VIRINDA_JOB_BROKER=nats
# VIRINDA_NATS_URL=nats://127.0.0.1:4222
# VIRINDA_NATS_CREDS=
VIRINDA_NATS_STREAM=virinda_jobs
VIRINDA_NATS_SUBJECT_PREFIX=virinda.jobs
VIRINDA_NATS_DURABLE=virinda-workers
