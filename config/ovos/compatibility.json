{
  "schema_version": 1,
  "virinda_version": "0.19.0",
  "stable_channel": {
    "constraints_file": "config/ovos/constraints-stable.txt",
    "source": "https://raw.githubusercontent.com/OpenVoiceOS/ovos-releases/main/constraints-stable.txt",
    "required": {
      "ovos-core": ">=1.3.1,<1.4.0",
      "ovos-dinkum-listener": ">=0.4.0,<0.5.0",
      "ovos-audio": ">=0.4.0,<0.5.0",
      "ovos-plugin-manager": ">=0.9.0,<0.10.0",
      "ovos-persona": ">=0.6.23,<0.7.0",
      "ovos-openai-plugin": ">=2.0.3,<2.1.0",
      "ovos-microphone-plugin-alsa": ">=0.1.2,<0.2.0",
      "ovos-workshop": ">=3.4.0,<3.5.0"
    },
    "persona": "ovos-solver-openai-plugin",
    "supported_stack": {
      "ovos-messagebus": ">=0.0.10,<0.1.0",
      "ovos-bus-client": ">=1.3.4,<1.4.0",
      "ovos-audio-plugin-mpv": ">=0.2.1,<0.3.0",
      "ovos-stt-plugin-vosk": ">=0.2.3,<0.3.0"
    }
  },
  "audio_addons": {
    "constraints_file": "config/ovos/virinda-audio-overrides.txt",
    "stable_plugin_pins": {
      "ovos-vad-plugin-silero": "==0.0.5",
      "ovos-ww-plugin-openwakeword": "==0.4.1"
    },
    "extra_pins": {
      "ovos-stt-plugin-whispercpp": "==0.0.1",
      "phoonnx": "==1.3.3"
    }
  },
  "experimental_agent": {
    "profile": "config/ovos/experimental-agent/virinda-persona.json",
    "requires": {
      "ovos-persona": ">=0.9.0a1",
      "ovos-plugin-manager": ">=2.2.3a1",
      "ovos-openai-plugin": ">=2.2.0"
    },
    "persona": "ovos-chat-openai-plugin"
  },
  "reliability_policy": {
    "authoritative_rule": "Use one upstream stable constraints set for the OVOS runtime. Optional plugins are separately classified and validated.",
    "tier_a_production": [
      "ovos-core",
      "ovos-dinkum-listener",
      "ovos-audio",
      "ovos-plugin-manager",
      "ovos-persona",
      "ovos-openai-plugin",
      "ovos-messagebus",
      "ovos-bus-client",
      "ovos-microphone-plugin-alsa",
      "ovos-audio-plugin-mpv",
      "ovos-ww-plugin-openwakeword",
      "ovos-vad-plugin-silero"
    ],
    "tier_b_stable_local_fallback": [
      "ovos-stt-plugin-vosk"
    ],
    "tier_c_virinda_addons": [
      "ovos-stt-plugin-whispercpp",
      "phoonnx"
    ],
    "tier_d_experimental_or_legacy": [
      "ovos-chat-openai-plugin",
      "ovos-tts-plugin-piper",
      "ovos-tts-plugin-mimic3"
    ]
  }
}
