[Unit]
Description=Marina OVOS voice listener
After=marina-messagebus.service
Requires=marina-messagebus.service

[Service]
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Type=simple
ExecStart=@MARINA_VENV@/bin/ovos-dinkum-listener
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
