[Unit]
Description=Marina OVOS audio service
After=virinda-messagebus.service
Requires=virinda-messagebus.service

[Service]
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Type=simple
ExecStart=@VIRINDA_VENV@/bin/ovos-audio
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
