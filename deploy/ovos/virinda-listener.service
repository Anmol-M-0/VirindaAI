[Unit]
Description=Virinda OVOS voice listener
After=virinda-messagebus.service
Requires=virinda-messagebus.service

[Service]
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Type=simple
ExecStart=@VIRINDA_VENV@/bin/ovos-dinkum-listener
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
