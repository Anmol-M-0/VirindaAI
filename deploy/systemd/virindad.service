[Unit]
Description=VirindaAI assistant daemon
After=pipewire.service pipewire-pulse.service graphical-session.target
Wants=pipewire.service

[Service]
Type=simple
ExecStart=%h/.local/bin/virindad
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
