#!/usr/bin/env bash
# ==============================================================================
# virinda - Standalone Unix CLI runner for VirindaAI
# ==============================================================================

set -euo pipefail

# Resolve symlinks to find true script directory
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
WORKSPACE_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Add virtual environment site-packages if available
for sp in "$SCRIPT_DIR"/.venv/lib/python*/site-packages "$WORKSPACE_ROOT"/VirindAI/.venv/lib/python*/site-packages; do
    if [ -d "$sp" ]; then
        export PYTHONPATH="$sp:${PYTHONPATH:-}"
    fi
done

export PYTHONPATH="$SCRIPT_DIR/src:${PYTHONPATH:-}"

# Load .env if present
if [ -f "$SCRIPT_DIR/.env" ]; then
    set -a
    # shellcheck disable=SC1091
    source "$SCRIPT_DIR/.env" 2>/dev/null || true
    set +a
elif [ -f "$WORKSPACE_ROOT/.env" ]; then
    set -a
    # shellcheck disable=SC1091
    source "$WORKSPACE_ROOT/.env" 2>/dev/null || true
    set +a
fi

# Execute CLI using the best available Python / uv environment
if [ -f "$SCRIPT_DIR/.venv/bin/python3" ]; then
    exec "$SCRIPT_DIR/.venv/bin/python3" -m virinda.interfaces.cli "$@"
elif [ -f "$SCRIPT_DIR/.venv/bin/python" ]; then
    exec "$SCRIPT_DIR/.venv/bin/python" -m virinda.interfaces.cli "$@"
elif command -v uv >/dev/null 2>&1 && [ -f "$SCRIPT_DIR/pyproject.toml" ]; then
    exec uv run --project "$SCRIPT_DIR" python -m virinda.interfaces.cli "$@"
else
    exec python3 -m virinda.interfaces.cli "$@"
fi
